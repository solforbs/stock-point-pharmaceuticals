# Production settings for the Stockpoint pharmacy ERP.
# deploy/provision.sh copies this to .env and fills the CHANGE_ME values;
# edit by hand afterwards, then run `php artisan config:cache`.

APP_NAME="Stockpoint ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi
APP_URL=https://CHANGE_ME_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pharmacy_erp
DB_USERNAME=pharmacy_erp
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# The SPA and the API share one origin; the session cookie must be HTTPS-only.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=CHANGE_ME_DOMAIN
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME_DOMAIN

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# The legal entity printed on invoices and identified to KRA (OrganisationSeeder).
ORG_NAME="Stockpoint Pharma Wholesalers Ltd"
ORG_KRA_PIN=CHANGE_ME_KRA_PIN
ORG_BRANCH_CODE=LDW
ORG_BRANCH_NAME="Lodwar Main Branch"
ORG_COUNTY=Turkana

# eTIMS stays in log mode until the integrator mapping is done (sales queue
# up and can be submitted later from the Tax Centre).
ETIMS_ENABLED=false
ETIMS_DRIVER=log

VITE_APP_NAME="${APP_NAME}"
